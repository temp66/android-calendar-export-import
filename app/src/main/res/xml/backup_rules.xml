<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing to back up: the app keeps no state of its own, and the backup file is wherever the
  user chose to put it. Applies to Android 11 and lower.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
