<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon layer for Android 13 and higher: a single-colour silhouette the system tints. The
  even-odd fill turns the two event marks into holes; the tabs are drawn as a separate path so
  their overlap with the body does not punch a hole in it.
-->
<!-- fillType needs API 24, but this layer is only drawn on API 33+, so ignoring it below that is
     harmless; tools:targetApi keeps lint from flagging it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="24"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.75"
        android:scaleY="2.75"
        android:translateX="21"
        android:translateY="21">
        <path
            android:fillColor="#000000"
            android:fillType="evenOdd"
            android:pathData="M4,5h16c1.1,0 2,0.9 2,2v12c0,1.1 -0.9,2 -2,2H4c-1.1,0 -2,-0.9 -2,-2V7c0,-1.1 0.9,-2 2,-2zM6,12h5v5H6zM13,12h5v5h-5z" />
        <path
            android:fillColor="#000000"
            android:pathData="M7,2h2v4H7zM15,2h2v4h-2z" />
    </group>
</vector>
